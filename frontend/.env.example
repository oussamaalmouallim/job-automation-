# Copier vers frontend/.env si besoin. En local, rien n'est obligatoire.

# Adresse publique du backend. Vide en local : le proxy Vite envoie /api vers localhost:4000.
# En démo : ex. https://xxxx.trycloudflare.com/api
VITE_API_URL=

# Chemin de base du site. Vide = /job-automation-/ (GitHub Pages). Mettre / pour Vercel.
# VITE_BASE=/

# Webhook du scraper, seulement pour viser un autre n8n que celui du backend.
# VITE_N8N_SCRAPER_WEBHOOK=
