PORT=4000
# PostgreSQL de développement (docker-compose.yml, port 5433). Lancer : docker compose up -d db
DATABASE_URL="postgresql://linkedai:linkedai@localhost:5433/linkedai"

# OpenRouter : la clé reste côté serveur, jamais dans le front
OPENROUTER_API_KEY=

# Origines autorisées à appeler le backend depuis un navigateur (séparées par des virgules).
# Pour la démo, ajouter l'adresse du front déployé (ex. https://mon-app.vercel.app).
# 3100 : front lancé pour les tests (E2E_PORT=3100)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3100

# Adresse publique du front, envoyée à OpenRouter comme référent
APP_URL=http://localhost:3000

# n8n : adresse locale ; seuls les webhooks resource-suggestions, generate-visual et scraper sont relayés
N8N_BASE_URL=http://localhost:5678

# Fournisseurs de profils (docs/sources.md), essayés dans cet ordre ; vide = fournisseur ignoré.
# n8n reste le dernier secours. Ne jamais mettre ces clés dans le front.
SERPER_API_KEY=
BRAVE_API_KEY=

# Comptes et sessions (Better Auth). Secret obligatoire en production : openssl rand -hex 32
BETTER_AUTH_SECRET=
# Adresse publique du backend (liens des e-mails de réinitialisation)
BETTER_AUTH_URL=http://localhost:4000
