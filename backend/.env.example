PORT=4000
DATABASE_URL="file:./dev.db"

# OpenRouter : la clé reste côté serveur, jamais dans le front
OPENROUTER_API_KEY=

# Origines autorisées à appeler le backend depuis un navigateur (séparées par des virgules).
# Pour la démo, ajouter l'adresse du front déployé (ex. https://mon-app.vercel.app).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Adresse publique du front, envoyée à OpenRouter comme référent
APP_URL=http://localhost:3000

# n8n : adresse locale ; seuls les webhooks resource-suggestions, generate-visual et scraper sont relayés
N8N_BASE_URL=http://localhost:5678
